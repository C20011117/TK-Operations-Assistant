# 复制为 .env 后填写。只列变量名和本地开发默认值，真实密钥不要提交。
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:5173

# PostgreSQL（Docker，主机端口 55432）
POSTGRES_SUPERUSER_PASSWORD=
APP_OWNER_PASSWORD=
APP_RUNTIME_PASSWORD=
APP_DISPATCHER_PASSWORD=
DB_HOST=localhost
DB_PORT=55432
DB_NAME=tk_workspace

# Redis（Docker，主机端口 56379）
REDIS_URL=redis://localhost:56379/0

# 对象存储（MinIO，主机端口 59000 / 控制台 59001）
OBJECT_STORAGE_ENDPOINT=http://localhost:59000
OBJECT_STORAGE_BUCKET=tk-workspace-dev
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# 可选：替换默认 MinIO 镜像（需同时包含 minio 与 mc）
MINIO_IMAGE=

# 会话
SESSION_TTL_HOURS=12

# 大模型（OpenAI 兼容接口）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_MATCHING=
LLM_MODEL_BRIEF=
LLM_STRUCTURED_MODE=json_schema
LLM_TIMEOUT_SECONDS=60
LLM_DATA_REGION=
LLM_PROVIDER_DPA_REF=

# FastMoss MCP（开发期使用；正式版改为企业连接中心加密保存）
FASTMOSS_MCP_URL=https://mcp.fastmoss.com/mcp
FASTMOSS_MCP_API_KEY=

# 开发种子账号密码（仅 development / test）
SEED_DEV_PASSWORD=
