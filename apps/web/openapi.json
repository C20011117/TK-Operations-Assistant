{
  "openapi": "3.1.0",
  "info": {
    "title": "TK 达人工作台（桌面版）本机接口",
    "version": "0.2.0"
  },
  "paths": {
    "/api/v1/system/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "健康检查（数据库）",
        "operationId": "health_api_v1_system_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/info": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "版本与数据目录",
        "operationId": "info_api_v1_system_info_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/jobs": {
      "post": {
        "tags": [
          "system"
        ],
        "summary": "创建测试任务（幂等）",
        "operationId": "create_job_api_v1_system_jobs_post",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 200,
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJobRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "system"
        ],
        "summary": "最近的任务",
        "operationId": "list_jobs_api_v1_system_jobs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobView"
                  },
                  "title": "Response List Jobs Api V1 System Jobs Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/jobs/{job_id}": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "任务状态",
        "operationId": "get_job_api_v1_system_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/jobs/{job_id}/cancel": {
      "post": {
        "tags": [
          "system"
        ],
        "summary": "取消任务",
        "operationId": "cancel_job_api_v1_system_jobs__job_id__cancel_post",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/markets": {
      "get": {
        "tags": [
          "markets"
        ],
        "summary": "站点目录",
        "operationId": "markets_index_api_v1_markets_get",
        "parameters": [
          {
            "name": "region_group",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "europe",
              "title": "Region Group"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Market"
                  },
                  "title": "Response Markets Index Api V1 Markets Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/markets/{market_code}": {
      "get": {
        "tags": [
          "markets"
        ],
        "summary": "单个站点",
        "operationId": "market_detail_api_v1_markets__market_code__get",
        "parameters": [
          {
            "name": "market_code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Market Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Market"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settings": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "当前设置（不含密钥明文）",
        "operationId": "get_settings_view_api_v1_settings_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settings/llm": {
      "put": {
        "tags": [
          "settings"
        ],
        "summary": "保存大模型设置",
        "operationId": "put_llm_api_v1_settings_llm_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LLMSettingsUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settings/fastmoss": {
      "put": {
        "tags": [
          "settings"
        ],
        "summary": "保存 FastMoss API Key（空字符串表示删除）",
        "operationId": "put_fastmoss_api_v1_settings_fastmoss_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FastMossSettingsUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settings/checks": {
      "post": {
        "tags": [
          "settings"
        ],
        "summary": "外部服务连通检查",
        "operationId": "external_checks_api_v1_settings_checks_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalChecks"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppInfo": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "data_dir": {
            "type": "string",
            "title": "Data Dir"
          }
        },
        "type": "object",
        "required": [
          "version",
          "data_dir"
        ],
        "title": "AppInfo"
      },
      "CreateJobRequest": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "system.noop",
            "title": "Kind",
            "default": "system.noop"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          }
        },
        "type": "object",
        "title": "CreateJobRequest"
      },
      "ExternalCheck": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "not_configured",
              "error"
            ],
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": ""
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "available_credits": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Available Credits"
          },
          "credit_cost": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Credit Cost"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ExternalCheck"
      },
      "ExternalChecks": {
        "properties": {
          "llm": {
            "$ref": "#/components/schemas/ExternalCheck"
          },
          "fastmoss": {
            "$ref": "#/components/schemas/ExternalCheck"
          }
        },
        "type": "object",
        "required": [
          "llm",
          "fastmoss"
        ],
        "title": "ExternalChecks"
      },
      "FastMossSettingsUpdate": {
        "properties": {
          "api_key": {
            "type": "string",
            "maxLength": 500,
            "title": "Api Key"
          }
        },
        "type": "object",
        "required": [
          "api_key"
        ],
        "title": "FastMossSettingsUpdate"
      },
      "FastMossSettingsView": {
        "properties": {
          "api_key_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key Hint"
          },
          "configured": {
            "type": "boolean",
            "title": "Configured"
          }
        },
        "type": "object",
        "required": [
          "api_key_hint",
          "configured"
        ],
        "title": "FastMossSettingsView"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "checks"
        ],
        "title": "Health"
      },
      "JobView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "waiting_input",
              "cancel_requested",
              "succeeded",
              "partial",
              "failed",
              "cancelled"
            ],
            "title": "Status"
          },
          "stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "progress": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Progress"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "last_error": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "attempt": {
            "type": "integer",
            "title": "Attempt"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "status",
          "stage",
          "progress",
          "result",
          "last_error",
          "attempt",
          "created_at",
          "updated_at",
          "started_at",
          "finished_at"
        ],
        "title": "JobView"
      },
      "LLMSettingsUpdate": {
        "properties": {
          "base_url": {
            "type": "string",
            "maxLength": 500,
            "title": "Base Url",
            "default": ""
          },
          "model_matching": {
            "type": "string",
            "maxLength": 200,
            "title": "Model Matching",
            "default": ""
          },
          "model_brief": {
            "type": "string",
            "maxLength": 200,
            "title": "Model Brief",
            "default": ""
          },
          "structured_mode": {
            "type": "string",
            "enum": [
              "json_schema",
              "function_calling",
              "json_mode"
            ],
            "title": "Structured Mode",
            "default": "json_schema"
          },
          "timeout_seconds": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 5.0,
            "title": "Timeout Seconds",
            "default": 60
          },
          "data_region": {
            "type": "string",
            "maxLength": 100,
            "title": "Data Region",
            "default": ""
          },
          "api_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key"
          }
        },
        "type": "object",
        "title": "LLMSettingsUpdate"
      },
      "LLMSettingsView": {
        "properties": {
          "base_url": {
            "type": "string",
            "title": "Base Url"
          },
          "model_matching": {
            "type": "string",
            "title": "Model Matching"
          },
          "model_brief": {
            "type": "string",
            "title": "Model Brief"
          },
          "structured_mode": {
            "type": "string",
            "enum": [
              "json_schema",
              "function_calling",
              "json_mode"
            ],
            "title": "Structured Mode"
          },
          "timeout_seconds": {
            "type": "integer",
            "title": "Timeout Seconds"
          },
          "data_region": {
            "type": "string",
            "title": "Data Region"
          },
          "api_key_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key Hint"
          },
          "configured": {
            "type": "boolean",
            "title": "Configured"
          }
        },
        "type": "object",
        "required": [
          "base_url",
          "model_matching",
          "model_brief",
          "structured_mode",
          "timeout_seconds",
          "data_region",
          "api_key_hint",
          "configured"
        ],
        "title": "LLMSettingsView"
      },
      "Market": {
        "properties": {
          "market_code": {
            "type": "string",
            "title": "Market Code"
          },
          "name_zh": {
            "type": "string",
            "title": "Name Zh"
          },
          "name_en": {
            "type": "string",
            "title": "Name En"
          },
          "region_group": {
            "type": "string",
            "title": "Region Group"
          },
          "settlement_currency": {
            "type": "string",
            "title": "Settlement Currency"
          },
          "default_time_zone": {
            "type": "string",
            "title": "Default Time Zone"
          },
          "content_languages": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Content Languages"
          },
          "fastmoss_region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fastmoss Region"
          },
          "data_status": {
            "type": "string",
            "enum": [
              "queryable",
              "queryable_currency_unknown",
              "platform_unconfirmed",
              "manual_import_only"
            ],
            "title": "Data Status"
          },
          "last_probe_total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Probe Total"
          },
          "probe_currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Probe Currency"
          },
          "notes": {
            "type": "string",
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "market_code",
          "name_zh",
          "name_en",
          "region_group",
          "settlement_currency",
          "default_time_zone",
          "content_languages",
          "fastmoss_region",
          "data_status",
          "last_probe_total",
          "probe_currency",
          "notes"
        ],
        "title": "Market"
      },
      "SettingsView": {
        "properties": {
          "llm": {
            "$ref": "#/components/schemas/LLMSettingsView"
          },
          "fastmoss": {
            "$ref": "#/components/schemas/FastMossSettingsView"
          }
        },
        "type": "object",
        "required": [
          "llm",
          "fastmoss"
        ],
        "title": "SettingsView"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
